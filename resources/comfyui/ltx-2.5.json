{
 "id": "ltx-2.5",
 "title": "LTX-2.5",
 "kind": "video",
 "description": "Text or image to video with a generated soundtrack.",
 "model": {
  "folder": "diffusion_models",
  "match": "(?i)^ltx.?2\\.?5.*\\.safetensors$",
  "exclude": "(?i)vae|upscal|encoder|lora",
  "set": [
   "1.unet_name"
  ]
 },
 "components": {
  "text_encoder": {
   "folder": "text_encoders",
   "match": "(?i)gemma.*ltx.*\\.safetensors$",
   "set": [
    "2.clip_name"
   ]
  },
  "video_vae": {
   "folder": "vae",
   "match": [
    "(?i)^ltx.?2\\.?5(?!.*conv).*video.?vae",
    "(?i)^ltx.?2\\.?5.*video.?vae"
   ],
   "set": [
    "3.vae_name"
   ]
  },
  "audio_vae": {
   "folder": "vae",
   "match": "(?i)^ltx.?2\\.?5.*audio.?vae",
   "set": [
    "4.vae_name"
   ]
  }
 },
 "params": {
  "prompt": {
   "type": "string",
   "required": true,
   "set": [
    "5.text"
   ],
   "description": "What happens in the clip, sound included."
  },
  "negative_prompt": {
   "type": "string",
   "default": "blurry, distorted, low quality",
   "set": [
    "6.text"
   ]
  },
  "image": {
   "type": "image",
   "set": [
    "30.image"
   ],
   "link": {
    "10.video_latent": [
     "31",
     0
    ]
   },
   "description": "Optional first frame; makes this image-to-video."
  },
  "width": {
   "type": "int",
   "default": 768,
   "min": 256,
   "max": 1920,
   "step": 32,
   "set": [
    "8.width"
   ]
  },
  "height": {
   "type": "int",
   "default": 448,
   "min": 256,
   "max": 1088,
   "step": 32,
   "set": [
    "8.height"
   ]
  },
  "fps": {
   "type": "int",
   "default": 24,
   "min": 8,
   "max": 60,
   "set": [
    "7.frame_rate",
    "9.frame_rate",
    "19.fps"
   ]
  },
  "frames": {
   "type": "int",
   "default": 97,
   "min": 9,
   "max": 481,
   "step": 8,
   "offset": 1,
   "description": "Length in frames (8n+1). Clients normally send 'seconds' instead.",
   "set": [
    "8.length",
    "9.frames_number"
   ]
  },
  "steps": {
   "type": "int",
   "default": 20,
   "min": 1,
   "max": 100,
   "set": [
    "12.steps"
   ]
  },
  "cfg_scale": {
   "type": "number",
   "default": 3.0,
   "min": 1,
   "max": 15,
   "set": [
    "13.cfg"
   ]
  },
  "seed": {
   "type": "int",
   "default": "random",
   "min": 0,
   "set": [
    "14.noise_seed"
   ]
  }
 },
 "output": {
  "node": "20"
 },
 "graph": {
  "1": {
   "class_type": "UNETLoader",
   "inputs": {
    "unet_name": "",
    "weight_dtype": "default"
   }
  },
  "2": {
   "class_type": "CLIPLoader",
   "inputs": {
    "clip_name": "",
    "type": "ltxv",
    "device": "default"
   }
  },
  "3": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": ""
   }
  },
  "4": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": ""
   }
  },
  "5": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "clip": [
     "2",
     0
    ],
    "text": ""
   }
  },
  "6": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "clip": [
     "2",
     0
    ],
    "text": ""
   }
  },
  "7": {
   "class_type": "LTXVConditioning",
   "inputs": {
    "positive": [
     "5",
     0
    ],
    "negative": [
     "6",
     0
    ],
    "frame_rate": 24.0
   }
  },
  "8": {
   "class_type": "EmptyLTXVLatentVideo",
   "inputs": {
    "width": 768,
    "height": 448,
    "length": 97,
    "batch_size": 1
   }
  },
  "9": {
   "class_type": "LTXVEmptyLatentAudio",
   "inputs": {
    "frames_number": 97,
    "frame_rate": 24,
    "batch_size": 1,
    "audio_vae": [
     "4",
     0
    ]
   }
  },
  "10": {
   "class_type": "LTXVConcatAVLatent",
   "inputs": {
    "video_latent": [
     "8",
     0
    ],
    "audio_latent": [
     "9",
     0
    ]
   }
  },
  "11": {
   "class_type": "KSamplerSelect",
   "inputs": {
    "sampler_name": "euler"
   }
  },
  "12": {
   "class_type": "LTXVScheduler",
   "inputs": {
    "steps": 20,
    "max_shift": 2.05,
    "base_shift": 0.95,
    "stretch": true,
    "terminal": 0.1,
    "latent": [
     "10",
     0
    ]
   }
  },
  "13": {
   "class_type": "CFGGuider",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "positive": [
     "7",
     0
    ],
    "negative": [
     "7",
     1
    ],
    "cfg": 3.0
   }
  },
  "14": {
   "class_type": "RandomNoise",
   "inputs": {
    "noise_seed": 0
   }
  },
  "15": {
   "class_type": "SamplerCustomAdvanced",
   "inputs": {
    "noise": [
     "14",
     0
    ],
    "guider": [
     "13",
     0
    ],
    "sampler": [
     "11",
     0
    ],
    "sigmas": [
     "12",
     0
    ],
    "latent_image": [
     "10",
     0
    ]
   }
  },
  "16": {
   "class_type": "LTXVSeparateAVLatent",
   "inputs": {
    "av_latent": [
     "15",
     0
    ]
   }
  },
  "17": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "16",
     0
    ],
    "vae": [
     "3",
     0
    ]
   }
  },
  "18": {
   "class_type": "LTXVAudioVAEDecode",
   "inputs": {
    "samples": [
     "16",
     1
    ],
    "audio_vae": [
     "4",
     0
    ]
   }
  },
  "19": {
   "class_type": "CreateVideo",
   "inputs": {
    "images": [
     "17",
     0
    ],
    "fps": 24.0,
    "audio": [
     "18",
     0
    ]
   }
  },
  "20": {
   "class_type": "SaveVideo",
   "inputs": {
    "video": [
     "19",
     0
    ],
    "filename_prefix": "hemera/video",
    "format": "auto",
    "codec": "auto"
   }
  },
  "30": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "31": {
   "class_type": "LTXVImgToVideoInplace",
   "inputs": {
    "vae": [
     "3",
     0
    ],
    "image": [
     "30",
     0
    ],
    "latent": [
     "8",
     0
    ],
    "strength": 1.0,
    "bypass": false
   }
  }
 }
}
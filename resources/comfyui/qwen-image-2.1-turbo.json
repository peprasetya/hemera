   "inputs": {
    "vae_name": ""
   }
  },
  "4": {
   "class_type": "TextEncodeQwenImage21",
   "inputs": {
    "clip": [
     "2",
     0
    ],
    "prompt": "",
    "negative_prompt": "",
    "resolution": 1024
   }
  },
  "5": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 1024,
    "height": 1024,
    "batch_size": 1
   }
  },
  "8": {

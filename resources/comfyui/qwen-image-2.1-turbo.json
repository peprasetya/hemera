{
 "id": "qwen-image-2.1-turbo",
 "title": "Qwen-Image 2.1 Turbo",
 "kind": "image",
 "description": "Text to image with the 7B Qwen-Image 2.1 Turbo in 8 steps; good at text inside images, native up to 2048 px.",
 "model": {
  "folder": "diffusion_models",
  "match": "(?i)^qwen_image_2\\.1.*turbo.*\\.safetensors$",
  "exclude": "(?i)lora|vae",
  "set": [
   "1.unet_name"
  ]
 },
 "components": {
  "text_encoder": {
   "folder": "text_encoders",
   "match": [
    "(?i)^qwen3vl_8b_int8_convrot\\.safetensors$",
    "(?i)^qwen3vl_8b_bf16\\.safetensors$",
    "(?i)^qwen3vl_8b_w4a8\\.safetensors$"
   ],
   "set": [
    "2.clip_name"
   ]
  },
  "vae": {
   "folder": "vae",
   "match": "(?i)^qwen_image_2\\.1_vae",
   "set": [
    "3.vae_name"
   ]
  }
 },
 "params": {
  "prompt": {
   "type": "string",
   "required": true,
   "set": [
    "4.prompt"
   ]
  },
  "negative_prompt": {
   "type": "string",
   "default": "",
   "description": "Ignored while cfg_scale is 1, which is the default.",
   "set": [
    "4.negative_prompt"
   ]
  },
  "width": {
   "type": "int",
   "default": 1024,
   "min": 256,
   "max": 2048,
   "step": 32,
   "set": [
    "5.width"
   ]
  },
  "height": {
   "type": "int",
   "default": 1024,
   "min": 256,
   "max": 2048,
   "step": 32,
   "set": [
    "5.height"
   ]
  },
  "steps": {
   "type": "int",
   "default": 8,
   "min": 1,
   "max": 50,
   "set": [
    "8.steps"
   ]
  },
  "cfg_scale": {
   "type": "number",
   "default": 1.0,
   "min": 1,
   "max": 10,
   "set": [
    "8.cfg"
   ]
  },
  "seed": {
   "type": "int",
   "default": "random",
   "min": 0,
   "set": [
    "8.seed"
   ]
  },
  "image": {
   "type": "image",
   "set": [
    "11.image"
   ],
   "link": {
    "4.images.image_1": [
     "11",
     0
    ],
    "4.vae": [
     "3",
     0
    ]
   },
   "description": "Reference image to edit or combine"
  },
  "image_2": {
   "type": "image",
   "set": [
    "12.image"
   ],
   "link": {
    "4.images.image_2": [
     "12",
     0
    ]
   },
   "description": "Another reference image"
  },
  "image_3": {
   "type": "image",
   "set": [
    "13.image"
   ],
   "link": {
    "4.images.image_3": [
     "13",
     0
    ]
   },
   "description": "Another reference image"
  }
 },
 "output": {
  "node": "10"
 },
 "graph": {

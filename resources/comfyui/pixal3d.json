{
 "id": "pixal3d",
 "title": "Pixal3D",
 "kind": "3d",
 "description": "Image to 3D mesh. Follows the source image most closely, camera angle included; vertex colours in minutes, or a UV-unwrapped mesh with PBR maps (slow: the unwrap runs on the CPU).",
 "model": {
  "folder": "diffusion_models",
  "match": "(?i)^pixal.?3d.*\\.safetensors$",
  "exclude": "(?i)multiview",
  "set": [
   "40.unet_name"
  ]
 },
 "components": {
  "shape_vae": {
   "folder": "vae",
   "match": "(?i)trellis.?2.*shape.*vae",
   "set": [
    "117.vae_name"
   ]
  },
  "texture_vae": {
   "folder": "vae",
   "match": "(?i)trellis.?2.*texture.*vae",
   "set": [
    "118.vae_name"
   ]
  },
  "image_encoder": {
   "folder": "clip_vision",
   "match": "(?i)dino.?v3",
   "set": [
    "15.clip_name"
   ]
  },
  "background_removal": {
   "folder": "background_removal",
   "match": "(?i)birefnet",
   "set": [
    "193.bg_removal_name"
   ]
  },
  "geometry": {
   "folder": "geometry_estimation",
   "match": "(?i)moge",
   "set": [
    "55.model_name"
   ]
  }
 },
 "params": {
  "image": {
   "type": "image",
   "required": true,
   "set": [
    "122.image"
   ],
   "description": "The object to model: one subject, whole and uncropped. Its background is removed automatically."
  },
  "texture": {
   "type": "enum",
   "default": "vertex",
   "description": "vertex: colours stored per vertex on a dense mesh (minutes). pbr: UV-unwrapped mesh with base colour, metallic, roughness, normal and occlusion maps (tens of minutes). none: geometry only.",
   "values": {
    "vertex": {
     "900.mesh": [
      "252",
      0
     ]
    },
    "pbr": {
     "900.mesh": [
      "260",
      0
     ],
     "186.target_face_count": 200000,
     "288.value": 2048
    },
    "none": {
     "900.mesh": [
      "238",
      0
     ]
    }
   }
  },
  "faces": {
   "type": "int",
   "min": 5000,
   "max": 2000000,
   "description": "Triangles in the finished mesh. Defaults to 700000 for vertex colours, which need the density, and 200000 for pbr.",
   "set": [
    "186.target_face_count"
   ]
  },
  "texture_size": {
   "type": "int",
   "min": 512,
   "max": 4096,
   "step": 512,
   "description": "Side of the square PBR maps in pixels; only used by texture=pbr, where it defaults to 2048.",
   "set": [
    "288.value"
   ]
  },
  "remove_background": {
   "type": "bool",
   "default": true,
   "description": "Cut the subject out first. Turn off for an image that already has a transparent background.",
   "apply": {
    "true": {
     "248.switch": true
    },
    "false": {
     "248.switch": false
    }
   }
  },
  "seed": {
   "type": "int",
   "default": "random",
   "min": 0,
   "description": "Same seed, same image, same settings: same mesh.",
   "set": [
    "3.seed",
    "18.seed",
    "23.seed",
    "12.seed"
   ]
  }
 },

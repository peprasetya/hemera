# systemd unit for hemera — install as /etc/systemd/system/hemera.service
#   systemctl daemon-reload && systemctl enable --now hemera
# Logs go to journalctl -u hemera (hemera prints no timestamps; journald adds them).
[Unit]
Description=Hemera AI engine manager & API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hemera
# -Djdk.lang.Process.launchMechanism=FORK: hemera spawns engine processes constantly (every
# model load), and the JVM's default POSIX_SPAWN launch path on Linux has a known flaky failure
# mode ("Failed to exec spawn helper", errno 0) under memory/process churn that has nothing to
# do with the target binary. Classic fork()+exec() doesn't share that failure mode.
ExecStart=/usr/bin/java -Djdk.lang.Process.launchMechanism=FORK -jar /opt/hemera/hemera.jar
Restart=on-failure
RestartSec=3
SyslogIdentifier=hemera
# Engines run as children of hemera, so they share this unit's cgroup. Without this,
# a model too large for RAM gets OOM-killed and systemd stops the whole gateway with it;
# hemera additionally marks engines as preferred OOM victims so it survives to report the failure.
OOMPolicy=continue
# Uncomment to override the data directory:
# Environment=HEMERA_HOME=/opt/hemera

[Install]
WantedBy=multi-user.target
